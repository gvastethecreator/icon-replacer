<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="IconReplacer.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:IconReplacer.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Icon Replacer"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="WindowRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="Icon Replacer" />
        <Grid Grid.Row="1">
            <ProgressRing
                x:Name="StartupProgress"
                Width="36"
                Height="36"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="StartupProgress"
                AutomationProperties.Name="Loading Icon Replacer"
                IsActive="True" />
            <Frame x:Name="RootFrame" />
        </Grid>
    </Grid>
</Window>
