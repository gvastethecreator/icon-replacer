<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="IconReplacer.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:IconReplacer.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:IconReplacer.App.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="MetricTemplate">
            <Grid
                MinWidth="156"
                MinHeight="92"
                Padding="16"
                RowSpacing="4"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    Text="{Binding Label}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock
                    Grid.Row="1"
                    Text="{Binding Value}"
                    Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Grid.Row="2"
                    Text="{Binding Detail}"
                    TextTrimming="CharacterEllipsis"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="RouteRowTemplate">
            <Grid Padding="0,10" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock
                        Text="{Binding Title}"
                        TextTrimming="CharacterEllipsis"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        Text="{Binding Detail}"
                        TextTrimming="CharacterEllipsis"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
                <TextBlock
                    Grid.Column="1"
                    MinWidth="88"
                    Text="{Binding Status}"
                    TextAlignment="Right"
                    Style="{StaticResource CaptionTextBlockStyle}" />
                <Button
                    Grid.Column="2"
                    MinWidth="88"
                    AutomationProperties.Name="{Binding ActionLabel}"
                    Command="{Binding ActionCommand}"
                    Content="{Binding ActionLabel}"
                    IsEnabled="{Binding IsActionEnabled}"
                    Visibility="{Binding ActionVisibility}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <NavigationView
        x:Name="AppNavigation"
        AutomationProperties.AutomationId="AppNavigation"
        PaneDisplayMode="LeftCompact"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        SelectionChanged="AppNavigation_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="HomeNavItem" Content="Home" Tag="home">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Home" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Icons" Tag="icon-browser">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Library" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Recent" Tag="history">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Clock" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Diagnostics" Tag="diagnostics">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Setting" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Package" Tag="package-plan">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Folder" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <Grid Padding="24" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock
                        Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}"
                        Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.PageSubtitle, Mode=OneWay}"
                        Style="{StaticResource BodyTextBlockStyle}" />
                </StackPanel>
                <CommandBar
                    Grid.Column="1"
                    AutomationProperties.AutomationId="PageCommandBar"
                    Background="Transparent"
                    DefaultLabelPosition="Right">
                    <AppBarButton
                        AutomationProperties.AutomationId="RefreshButton"
                        Command="{x:Bind ViewModel.RefreshCommand}"
                        Label="Refresh">
                        <AppBarButton.Icon>
                            <SymbolIcon Symbol="Refresh" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        AutomationProperties.AutomationId="ImportIconsButton"
                        Command="{x:Bind ViewModel.ImportIconsCommand}"
                        Label="Import">
                        <AppBarButton.Icon>
                            <SymbolIcon Symbol="Add" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        AutomationProperties.AutomationId="OpenLibraryButton"
                        Command="{x:Bind ViewModel.OpenIconLibraryCommand}"
                        Label="Open library">
                        <AppBarButton.Icon>
                            <SymbolIcon Symbol="OpenFile" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar>
            </Grid>

            <InfoBar
                Grid.Row="1"
                AutomationProperties.AutomationId="StatusInfoBar"
                IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=OneWay}"
                IsClosable="False"
                Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}"
                Title="{x:Bind ViewModel.StatusTitle, Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />

            <GridView
                Grid.Row="2"
                AutomationProperties.AutomationId="MetricsGrid"
                ItemsSource="{x:Bind ViewModel.Metrics, Mode=OneWay}"
                ItemTemplate="{StaticResource MetricTemplate}"
                IsItemClickEnabled="False"
                SelectionMode="None"
                MaxHeight="132" />

            <Grid Grid.Row="3" ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Text="{x:Bind ViewModel.PrimaryListTitle, Mode=OneWay}"
                        Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ListView
                        Grid.Row="1"
                        AutomationProperties.AutomationId="PrimaryRowsList"
                        ItemsSource="{x:Bind ViewModel.PrimaryRows, Mode=OneWay}"
                        ItemTemplate="{StaticResource RouteRowTemplate}"
                        SelectionMode="None" />
                </Grid>

                <Grid Grid.Column="1" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Text="{x:Bind ViewModel.SecondaryListTitle, Mode=OneWay}"
                        Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ListView
                        Grid.Row="1"
                        AutomationProperties.AutomationId="SecondaryRowsList"
                        ItemsSource="{x:Bind ViewModel.SecondaryRows, Mode=OneWay}"
                        ItemTemplate="{StaticResource RouteRowTemplate}"
                        SelectionMode="None" />
                </Grid>
            </Grid>
        </Grid>
    </NavigationView>
</Page>
