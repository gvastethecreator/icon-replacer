<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="IconReplacer.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:vm="using:IconReplacer.App.ViewModels"
    Background="Transparent"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <AcrylicBrush
                        x:Key="GalleryAcrylicSurfaceBrush"
                        FallbackColor="#F7F7F7"
                        TintColor="#F7F7F7"
                        TintLuminosityOpacity="0.82"
                        TintOpacity="0.72" />
                    <SolidColorBrush x:Key="GalleryContentSurfaceBrush" Color="#FCFCFC" />
                    <SolidColorBrush x:Key="GallerySubtleSurfaceBrush" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="GalleryBorderBrush" Color="#03000000" />
                    <SolidColorBrush x:Key="GallerySelectedBrush" Color="#163E7B4B" />
                    <SolidColorBrush x:Key="GalleryAccentBrush" Color="#2F6F3E" />
                    <SolidColorBrush x:Key="GallerySplitterBrush" Color="#777777" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <AcrylicBrush
                        x:Key="GalleryAcrylicSurfaceBrush"
                        FallbackColor="#202020"
                        TintColor="#202020"
                        TintLuminosityOpacity="0.72"
                        TintOpacity="0.66" />
                    <SolidColorBrush x:Key="GalleryContentSurfaceBrush" Color="#181818" />
                    <SolidColorBrush x:Key="GallerySubtleSurfaceBrush" Color="#252525" />
                    <SolidColorBrush x:Key="GalleryBorderBrush" Color="#03FFFFFF" />
                    <SolidColorBrush x:Key="GallerySelectedBrush" Color="#283E9A54" />
                    <SolidColorBrush x:Key="GalleryAccentBrush" Color="#73C985" />
                    <SolidColorBrush x:Key="GallerySplitterBrush" Color="#AFAFAF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="GalleryAcrylicSurfaceBrush" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="GalleryContentSurfaceBrush" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="GallerySubtleSurfaceBrush" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="GalleryBorderBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="GallerySelectedBrush" ResourceKey="SystemColorHighlightColorBrush" />
                    <StaticResource x:Key="GalleryAccentBrush" ResourceKey="SystemColorHighlightColorBrush" />
                    <StaticResource x:Key="GallerySplitterBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <x:String x:Key="AboutAppIconPath">ms-appx:///Assets/AppIcon.png</x:String>

            <Style x:Key="SurfaceBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource GalleryAcrylicSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource GalleryBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>

            <Style x:Key="PaneSplitterStyle" TargetType="primitives:Thumb">
                <Setter Property="Width" Value="20" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="IsTabStop" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="primitives:Thumb">
                            <Grid Background="{TemplateBinding Background}">
                                <Border
                                    x:Name="SplitterHandle"
                                    Width="2"
                                    HorizontalAlignment="Center"
                                    Background="{ThemeResource GallerySplitterBrush}"
                                    CornerRadius="1"
                                    Opacity="0" />
                                <Border
                                    x:Name="DragIndicator"
                                    Width="20"
                                    Height="28"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource GallerySubtleSurfaceBrush}"
                                    CornerRadius="4"
                                    Opacity="0">
                                    <FontIcon
                                        FontFamily="Segoe UI Symbol"
                                        FontSize="14"
                                        Foreground="{ThemeResource GallerySplitterBrush}"
                                        Glyph="&#x2194;" />
                                </Border>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="SplitterHandle"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="0"
                                                    Duration="0:0:0.14" />
                                                <DoubleAnimation
                                                    Storyboard.TargetName="DragIndicator"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="0"
                                                    Duration="0:0:0.1" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="SplitterHandle"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="0.62"
                                                    BeginTime="0:0:0.14"
                                                    Duration="0:0:0.12" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="SplitterHandle"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="0.76"
                                                    Duration="0:0:0.04" />
                                                <DoubleAnimation
                                                    Storyboard.TargetName="DragIndicator"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="1"
                                                    Duration="0:0:0.08" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="SplitterHandle"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="0"
                                                    Duration="0" />
                                                <DoubleAnimation
                                                    Storyboard.TargetName="DragIndicator"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="0"
                                                    Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="IconGridItemStyle" TargetType="GridViewItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="3" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
            </Style>

            <DataTemplate x:Key="CategoryPreviewIconTemplate" x:DataType="vm:IconTileViewModel">
                <Border
                    Width="24"
                    Height="24"
                    Margin="0,0,4,0"
                    Background="{ThemeResource GallerySubtleSurfaceBrush}"
                    CornerRadius="3">
                    <Grid>
                        <FontIcon
                            FontSize="11"
                            Glyph="&#xE8B7;"
                            Opacity="0.35" />
                        <Image
                            Tag="{x:Bind FullPath}"
                            DataContextChanged="IconPreview_DataContextChanged"
                            Loaded="IconPreview_Loaded"
                            SizeChanged="IconPreview_SizeChanged"
                            Stretch="Uniform" />
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="CategoryTemplate" x:DataType="vm:IconCategoryViewModel">
                <Grid MinHeight="76" Padding="8" RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            FontWeight="SemiBold"
                            MaxLines="1"
                            Text="{x:Bind DisplayName}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{x:Bind IconCountText}"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </Grid>
                    <ItemsControl
                        Grid.Row="1"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        ItemTemplate="{StaticResource CategoryPreviewIconTemplate}"
                        ItemsSource="{x:Bind PreviewIcons}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="IconTileTemplate" x:DataType="vm:IconTileViewModel">
                <Border
                    Width="{x:Bind Layout.CellWidth, Mode=OneWay}"
                    Height="{x:Bind Layout.CellHeight, Mode=OneWay}"
                    Padding="6"
                    Background="{ThemeResource GallerySubtleSurfaceBrush}"
                    BorderBrush="{ThemeResource GalleryBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="36" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <FontIcon
                                FontSize="28"
                                Glyph="&#xE8B7;"
                                Opacity="0.25" />
                            <Image
                                Width="{x:Bind Layout.PreviewSize, Mode=OneWay}"
                                Height="{x:Bind Layout.PreviewSize, Mode=OneWay}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{x:Bind AccessibilityName}"
                                Tag="{x:Bind FullPath}"
                                DataContextChanged="IconPreview_DataContextChanged"
                                Loaded="IconPreview_Loaded"
                                SizeChanged="IconPreview_SizeChanged"
                                Stretch="Uniform" />
                        </Grid>
                        <TextBlock
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            MaxWidth="{x:Bind Layout.CellWidth, Mode=OneWay}"
                            FontSize="13"
                            LineHeight="16"
                            MaxLines="2"
                            Text="{x:Bind DisplayName}"
                            TextAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap"
                            ToolTipService.ToolTip="{x:Bind FullPath}" />
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="RecentCompactTemplate" x:DataType="vm:RecentChangeItemViewModel">
                <Grid
                    MinHeight="70"
                    Padding="4,8"
                    AutomationProperties.Name="{x:Bind AccessibilityName}"
                    ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="40"
                        Height="40"
                        Background="{ThemeResource GallerySubtleSurfaceBrush}"
                        CornerRadius="5">
                        <Grid>
                            <FontIcon Glyph="&#xE8B7;" Opacity="0.35" />
                            <Image
                                Width="30"
                                Height="30"
                                Tag="{x:Bind AppliedIconPath}"
                                DataContextChanged="IconPreview_DataContextChanged"
                                Loaded="IconPreview_Loaded"
                                SizeChanged="IconPreview_SizeChanged"
                                Stretch="Uniform" />
                        </Grid>
                    </Border>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="2">
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{x:Bind TargetDisplayName}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Text="{x:Bind Timestamp}"
                            TextTrimming="CharacterEllipsis"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                    <Button
                        Grid.Column="2"
                        Width="36"
                        Height="36"
                        Padding="0"
                        AutomationProperties.AutomationId="{x:Bind RestoreAutomationId}"
                        AutomationProperties.Name="{x:Bind RestoreAutomationName}"
                        Command="{x:Bind RestoreCommand}"
                        ToolTipService.ToolTip="Restore original icon">
                        <SymbolIcon Symbol="Undo" />
                    </Button>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="RecentFullTemplate" x:DataType="vm:RecentChangeItemViewModel">
                <Grid
                    MinHeight="80"
                    Padding="12"
                    AutomationProperties.Name="{x:Bind AccessibilityName}"
                    ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="48"
                        Height="48"
                        Background="{ThemeResource GallerySubtleSurfaceBrush}"
                        CornerRadius="6">
                        <Grid>
                            <FontIcon Glyph="&#xE8B7;" Opacity="0.35" />
                            <Image
                                Width="36"
                                Height="36"
                                Tag="{x:Bind AppliedIconPath}"
                                DataContextChanged="IconPreview_DataContextChanged"
                                Loaded="IconPreview_Loaded"
                                SizeChanged="IconPreview_SizeChanged"
                                Stretch="Uniform" />
                        </Grid>
                    </Border>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="3">
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{x:Bind TargetDisplayName}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Text="{x:Bind TargetDirectory}"
                            TextTrimming="CharacterEllipsis"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Text="{x:Bind TargetKind}"
                        Style="{StaticResource BodyTextBlockStyle}" />
                    <StackPanel
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Spacing="3">
                        <TextBlock Text="{x:Bind Status}" />
                        <TextBlock
                            Text="{x:Bind Timestamp}"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                    <Button
                        Grid.Column="4"
                        AutomationProperties.AutomationId="{x:Bind RestoreAutomationId}"
                        AutomationProperties.Name="{x:Bind RestoreAutomationName}"
                        Command="{x:Bind RestoreCommand}"
                        Content="Restore" />
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <NavigationView
        x:Name="AppNavigation"
        AlwaysShowHeader="False"
        AutomationProperties.AutomationId="AppNavigation"
        AutomationProperties.Name="Primary navigation"
        Background="Transparent"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        OpenPaneLength="184"
        PaneDisplayMode="LeftCompact"
        SelectionChanged="AppNavigation_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem
                x:Name="LibraryNavItem"
                AutomationProperties.AutomationId="LibraryNavItem"
                Content="Library"
                Tag="library">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Library" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                x:Name="RecentNavItem"
                AutomationProperties.AutomationId="RecentNavItem"
                Content="Recent"
                Tag="recent">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Clock" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <NavigationView.FooterMenuItems>
            <NavigationViewItem
                x:Name="AboutNavItem"
                AutomationProperties.AutomationId="AboutNavItem"
                Content="About"
                Tag="about"
                ToolTipService.ToolTip="About">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="ContactInfo" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                x:Name="SettingsNavItem"
                AutomationProperties.AutomationId="SettingsNavItem"
                Content="Settings"
                Tag="settings">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Setting" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <Grid Padding="14" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="ToolbarLayoutStates">
                    <VisualState x:Name="ToolbarWide">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1040" />
                        </VisualState.StateTriggers>
                    </VisualState>
                    <VisualState x:Name="ToolbarCompact">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="720" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="LibrarySummaryColumn.Width" Value="0" />
                            <Setter Target="LibrarySummaryPanel.Visibility" Value="Collapsed" />
                            <Setter Target="SearchBox.Width" Value="260" />
                            <Setter Target="PreviewSizeLabel.Visibility" Value="Collapsed" />
                            <Setter Target="PreviewSizeSlider.Width" Value="80" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="ToolbarNarrow">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="LibrarySummaryColumn.Width" Value="0" />
                            <Setter Target="LibrarySummaryPanel.Visibility" Value="Collapsed" />
                            <Setter Target="SearchBox.(Grid.Column)" Value="0" />
                            <Setter Target="SearchBox.(Grid.ColumnSpan)" Value="3" />
                            <Setter Target="SearchBox.Width" Value="320" />
                            <Setter Target="LibraryActionsPanel.(Grid.Row)" Value="1" />
                            <Setter Target="LibraryActionsPanel.(Grid.Column)" Value="0" />
                            <Setter Target="LibraryActionsPanel.(Grid.ColumnSpan)" Value="3" />
                            <Setter Target="LibraryActionsPanel.HorizontalAlignment" Value="Center" />
                            <Setter Target="PreviewSizeLabel.Visibility" Value="Collapsed" />
                            <Setter Target="PreviewSizeSlider.Width" Value="80" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Border
                x:Name="LibraryCommandSurface"
                Padding="12,4"
                Style="{StaticResource SurfaceBorderStyle}"
                Visibility="{x:Bind BoolToVisibility(ViewModel.IsLibraryVisible), Mode=OneWay}">
                <Grid
                    x:Name="LibraryToolbarGrid"
                    ColumnSpacing="16"
                    RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="LibrarySummaryColumn" Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        x:Name="LibrarySummaryPanel"
                        VerticalAlignment="Center"
                        Spacing="1">
                        <TextBlock
                            Text="Icon Library"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            AutomationProperties.AutomationId="LibrarySummaryText"
                            Text="{x:Bind ViewModel.LibrarySummary, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                    <AutoSuggestBox
                        x:Name="SearchBox"
                        Grid.Column="1"
                        Width="360"
                        Height="32"
                        HorizontalAlignment="Center"
                        AutomationProperties.AutomationId="IconSearchBox"
                        AutomationProperties.Name="Search icons"
                        PlaceholderText="Search icons"
                        TextChanged="SearchBox_TextChanged" />
                    <StackPanel
                        x:Name="LibraryActionsPanel"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="4">
                        <Button
                            Width="34"
                            Height="34"
                            Padding="0"
                            AutomationProperties.AutomationId="RefreshButton"
                            AutomationProperties.Name="Refresh library"
                            Command="{x:Bind ViewModel.RefreshCommand}"
                            ToolTipService.ToolTip="Refresh library">
                            <SymbolIcon Symbol="Refresh" />
                        </Button>
                        <Button
                            Width="34"
                            Height="34"
                            Padding="0"
                            AutomationProperties.AutomationId="ImportIconsButton"
                            AutomationProperties.Name="Import icons"
                            Command="{x:Bind ViewModel.ImportIconsCommand}"
                            ToolTipService.ToolTip="Import icons">
                            <SymbolIcon Symbol="Add" />
                        </Button>
                        <Button
                            Width="34"
                            Height="34"
                            Padding="0"
                            AutomationProperties.AutomationId="OpenLibraryButton"
                            AutomationProperties.Name="Open icon library"
                            Command="{x:Bind ViewModel.OpenIconLibraryCommand}"
                            ToolTipService.ToolTip="Open icon library">
                            <SymbolIcon Symbol="OpenFile" />
                        </Button>
                        <TextBlock
                            x:Name="PreviewSizeLabel"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Text="Size"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                        <Slider
                            x:Name="PreviewSizeSlider"
                            Width="96"
                            Height="30"
                            AutomationProperties.AutomationId="PreviewSizeSlider"
                            AutomationProperties.HelpText="Adjust icon previews from 48 to 112 pixels."
                            AutomationProperties.Name="Icon preview size"
                            Maximum="112"
                            Minimum="48"
                            SmallChange="8"
                            StepFrequency="8"
                            ValueChanged="PreviewSizeSlider_ValueChanged"
                            Value="{x:Bind ViewModel.IconPreviewSize, Mode=TwoWay}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid
                x:Name="LibrarySection"
                Grid.Row="1"
                AutomationProperties.AutomationId="LibrarySection"
                ColumnSpacing="0"
                Visibility="{x:Bind BoolToVisibility(ViewModel.IsLibraryVisible), Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="CollectionsColumn" Width="252" />
                    <ColumnDefinition x:Name="CollectionsSplitterColumn" Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="RecentColumn" Width="260" />
                </Grid.ColumnDefinitions>

                <Border
                    x:Name="CollectionsPane"
                    Padding="8"
                    Style="{StaticResource SurfaceBorderStyle}">
                    <Grid RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Padding="8,6" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Text="Collections"
                                Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{x:Bind ViewModel.CollectionCount, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                        </Grid>
                        <ListView
                            x:Name="CategoryList"
                            Grid.Row="1"
                            AutomationProperties.AutomationId="CategoryList"
                            AutomationProperties.Name="Icon collections"
                            ItemTemplate="{StaticResource CategoryTemplate}"
                            ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}"
                            SelectionMode="Single" />
                    </Grid>
                </Border>

                <primitives:Thumb
                    x:Name="CollectionsSplitter"
                    Grid.Column="1"
                    Canvas.ZIndex="10"
                    AutomationProperties.AutomationId="CollectionsSplitter"
                    AutomationProperties.HelpText="Drag, or use Left and Right arrow keys, to resize the Collections panel."
                    AutomationProperties.LocalizedControlType="splitter"
                    AutomationProperties.Name="Resize Collections panel"
                    DragCompleted="CollectionsSplitter_DragCompleted"
                    DragDelta="CollectionsSplitter_DragDelta"
                    DragStarted="CollectionsSplitter_DragStarted"
                    KeyDown="CollectionsSplitter_KeyDown"
                    Style="{StaticResource PaneSplitterStyle}"
                    ToolTipService.ToolTip="Resize Collections" />

                <Border
                    Grid.Column="2"
                    Background="{ThemeResource GalleryContentSurfaceBrush}"
                    BorderBrush="{ThemeResource GalleryBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Padding="16,12" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                AutomationProperties.AutomationId="SelectedCollectionTitle"
                                Text="{x:Bind ViewModel.SelectedCategory.DisplayName, Mode=OneWay, FallbackValue='All icons'}"
                                Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                Grid.Column="1"
                                AutomationProperties.AutomationId="VisibleSummaryText"
                                AutomationProperties.LiveSetting="Polite"
                                Text="{x:Bind ViewModel.VisibleSummary, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                        </Grid>
                        <Grid Grid.Row="1">
                            <GridView
                                x:Name="IconGrid"
                                Padding="10"
                                AutomationProperties.AutomationId="IconPreviewGrid"
                                AutomationProperties.Name="Icon previews"
                                ItemContainerStyle="{StaticResource IconGridItemStyle}"
                                ItemTemplate="{StaticResource IconTileTemplate}"
                                ItemsSource="{x:Bind ViewModel.VisibleIcons, Mode=OneWay}"
                                SizeChanged="IconGrid_SizeChanged"
                                SelectionMode="None">
                                <GridView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </GridView.ItemsPanel>
                            </GridView>
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="EmptyLibraryState"
                                AutomationProperties.LiveSetting="Polite"
                                AutomationProperties.Name="{x:Bind ViewModel.EmptyStateMessage, Mode=OneWay}"
                                Spacing="6"
                                Visibility="{x:Bind InverseBoolToVisibility(ViewModel.HasVisibleIcons), Mode=OneWay}">
                                <SymbolIcon Symbol="Find" />
                                <TextBlock
                                    MaxWidth="320"
                                    Text="{x:Bind ViewModel.EmptyStateMessage, Mode=OneWay}"
                                    TextAlignment="Center" />
                            </StackPanel>
                            <ProgressRing
                                Width="36"
                                Height="36"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="LibraryLoadingIndicator"
                                AutomationProperties.Name="Loading icon library"
                                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                        </Grid>
                    </Grid>
                </Border>

                <Border
                    x:Name="RecentPane"
                    Grid.Column="3"
                    Margin="4,0,0,0"
                    Padding="8"
                    Style="{StaticResource SurfaceBorderStyle}">
                    <Grid RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Margin="8,6"
                            Text="Recent changes"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ListView
                            Grid.Row="1"
                            AutomationProperties.AutomationId="RecentPreviewList"
                            AutomationProperties.Name="Recent icon changes preview"
                            ItemTemplate="{StaticResource RecentCompactTemplate}"
                            ItemsSource="{x:Bind ViewModel.RecentPreview, Mode=OneWay}"
                            SelectionMode="None" />
                        <Button
                            Grid.Row="2"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="ViewAllRecentButton"
                            AutomationProperties.Name="View all recent changes"
                            Click="ViewAllRecent_Click"
                            Content="View all changes" />
                    </Grid>
                </Border>

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup>
                        <VisualState x:Name="WideLayout">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="1180" />
                            </VisualState.StateTriggers>
                        </VisualState>
                        <VisualState x:Name="MediumLayout">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="880" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="RecentColumn.Width" Value="0" />
                                <Setter Target="RecentPane.Visibility" Value="Collapsed" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="CompactLayout">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="0" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="CollectionsColumn.Width" Value="0" />
                                <Setter Target="CollectionsPane.Visibility" Value="Collapsed" />
                                <Setter Target="CollectionsSplitterColumn.Width" Value="0" />
                                <Setter Target="CollectionsSplitter.Visibility" Value="Collapsed" />
                                <Setter Target="RecentColumn.Width" Value="0" />
                                <Setter Target="RecentPane.Visibility" Value="Collapsed" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
            </Grid>

            <Grid
                x:Name="RecentSectionRoot"
                Grid.Row="1"
                Padding="6"
                AutomationProperties.AutomationId="RecentSection"
                Visibility="{x:Bind BoolToVisibility(ViewModel.IsRecentVisible), Mode=OneWay}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock
                            Text="Recent changes"
                            Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock
                            Text="Review changed folders and shortcuts, then restore an original icon when needed."
                            Style="{StaticResource BodyTextBlockStyle}" />
                    </StackPanel>
                    <Border
                        Grid.Row="1"
                        Background="{ThemeResource GalleryContentSurfaceBrush}"
                        BorderBrush="{ThemeResource GalleryBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <ListView
                            AutomationProperties.AutomationId="RecentChangesList"
                            AutomationProperties.Name="Recent icon changes"
                            ItemTemplate="{StaticResource RecentFullTemplate}"
                            ItemsSource="{x:Bind ViewModel.RecentChanges, Mode=OneWay}"
                            SelectionMode="None" />
                    </Border>
                </Grid>
            </Grid>

            <Grid
                x:Name="SettingsSectionRoot"
                Grid.Row="1"
                Padding="6"
                AutomationProperties.AutomationId="SettingsSection"
                Visibility="{x:Bind BoolToVisibility(ViewModel.IsSettingsVisible), Mode=OneWay}">
                <ScrollViewer>
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left" Spacing="24">
                        <StackPanel Spacing="3">
                            <TextBlock
                                Text="Settings"
                                Style="{StaticResource TitleTextBlockStyle}" />
                            <TextBlock
                                Text="Keep the library comfortable without changing how Explorer commands work."
                                Style="{StaticResource BodyTextBlockStyle}" />
                        </StackPanel>
                        <StackPanel Spacing="10">
                            <TextBlock
                                Text="Appearance"
                                Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock
                                Text="Mica frames the window and Acrylic is reserved for navigation and command surfaces."
                                Style="{StaticResource BodyTextBlockStyle}" />
                            <RadioButtons
                                x:Name="ThemeSelector"
                                AutomationProperties.AutomationId="ThemeSelector"
                                AutomationProperties.Name="App theme"
                                SelectionChanged="ThemeSelector_SelectionChanged">
                                <x:String>Use system setting</x:String>
                                <x:String>Light</x:String>
                                <x:String>Dark</x:String>
                            </RadioButtons>
                        </StackPanel>
                        <StackPanel Spacing="10">
                            <TextBlock
                                Text="Icon Library"
                                Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock
                                MaxWidth="720"
                                AutomationProperties.AutomationId="SettingsLibraryPath"
                                AutomationProperties.Name="{x:Bind ViewModel.LibraryPath, Mode=OneWay}"
                                Text="{x:Bind ViewModel.LibraryPath, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind ViewModel.LibraryPath, Mode=OneWay}" />
                            <Button
                                HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="SettingsOpenLibraryButton"
                                AutomationProperties.Name="Open Icon Library"
                                Command="{x:Bind ViewModel.OpenIconLibraryCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="OpenFile" />
                                    <TextBlock Text="Open Icon Library" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid
                x:Name="AboutSectionRoot"
                Grid.Row="1"
                Padding="6"
                AutomationProperties.AutomationId="AboutSection"
                Visibility="{x:Bind BoolToVisibility(ViewModel.IsAboutVisible), Mode=OneWay}">
                <ScrollViewer>
                    <StackPanel
                        MaxWidth="760"
                        HorizontalAlignment="Left"
                        Spacing="24">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="64"
                                Height="64"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                CornerRadius="12">
                                <Image
                                    AutomationProperties.Name="Icon Replacer app icon"
                                    Source="{ThemeResource AboutAppIconPath}"
                                    Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock
                                    Text="Icon Replacer"
                                    Style="{StaticResource TitleTextBlockStyle}" />
                                <TextBlock
                                    AutomationProperties.AutomationId="AboutVersionText"
                                    Text="{x:Bind ViewModel.AppVersionText, Mode=OneWay}"
                                    Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    MaxWidth="640"
                                    Text="A focused Windows utility for changing and restoring folder and shortcut icons."
                                    TextWrapping="Wrap"
                                    Style="{StaticResource BodyTextBlockStyle}" />
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="{ThemeResource GalleryBorderBrush}" />

                        <StackPanel Spacing="10">
                            <TextBlock
                                Text="Project"
                                Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock
                                MaxWidth="720"
                                Text="Source, releases, issue tracking, and project history live on GitHub."
                                TextWrapping="Wrap"
                                Style="{StaticResource BodyTextBlockStyle}" />
                            <HyperlinkButton
                                HorizontalAlignment="Left"
                                Padding="0,4"
                                AutomationProperties.AutomationId="ProjectGitHubLink"
                                AutomationProperties.Name="Open Icon Replacer on GitHub"
                                NavigateUri="{x:Bind ViewModel.ProjectUri}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Link" />
                                    <TextBlock Text="github.com/gvastethecreator/icon-replacer" />
                                </StackPanel>
                            </HyperlinkButton>
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource GalleryBorderBrush}" />

                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock
                                        Text="Updates"
                                        Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock
                                        Text="Checks the latest published GitHub Release."
                                        Style="{StaticResource BodyTextBlockStyle}" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Top"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <ProgressRing
                                        Width="20"
                                        Height="20"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Checking for updates"
                                        IsActive="{x:Bind ViewModel.IsCheckingForUpdates, Mode=OneWay}"
                                        Visibility="{x:Bind BoolToVisibility(ViewModel.IsCheckingForUpdates), Mode=OneWay}" />
                                    <Button
                                        AutomationProperties.AutomationId="CheckForUpdatesButton"
                                        AutomationProperties.Name="Check for updates"
                                        Command="{x:Bind ViewModel.CheckForUpdatesCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <SymbolIcon Symbol="Refresh" />
                                            <TextBlock Text="Check for updates" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <StackPanel
                                AutomationProperties.AutomationId="UpdateStatusPanel"
                                AutomationProperties.LiveSetting="Polite"
                                Spacing="3">
                                <TextBlock
                                    AutomationProperties.AutomationId="UpdateStatusTitle"
                                    Text="{x:Bind ViewModel.UpdateStatusTitle, Mode=OneWay}"
                                    Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    MaxWidth="720"
                                    AutomationProperties.AutomationId="UpdateStatusMessage"
                                    Text="{x:Bind ViewModel.UpdateStatusMessage, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Style="{StaticResource BodyTextBlockStyle}" />
                                <HyperlinkButton
                                    HorizontalAlignment="Left"
                                    Padding="0,4"
                                    AutomationProperties.AutomationId="LatestReleaseLink"
                                    NavigateUri="{x:Bind ViewModel.LatestReleaseUri, Mode=OneWay}"
                                    Visibility="{x:Bind BoolToVisibility(ViewModel.IsUpdateLinkVisible), Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="Download" />
                                        <TextBlock Text="{x:Bind ViewModel.UpdateActionText, Mode=OneWay}" />
                                    </StackPanel>
                                </HyperlinkButton>
                            </StackPanel>
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource GalleryBorderBrush}" />

                        <StackPanel Spacing="10">
                            <TextBlock
                                Text="Credits"
                                Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock
                                Text="Created and maintained by gvastethecreator."
                                Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                MaxWidth="720"
                                Text="Built with .NET, WinUI 3, Windows App SDK, and CommunityToolkit.Mvvm. The application icon uses the official light and dark project artwork."
                                TextWrapping="Wrap"
                                Style="{StaticResource BodyTextBlockStyle}" />
                            <HyperlinkButton
                                HorizontalAlignment="Left"
                                Padding="0,4"
                                AutomationProperties.AutomationId="ProjectReleasesLink"
                                AutomationProperties.Name="Open Icon Replacer releases"
                                NavigateUri="{x:Bind ViewModel.ReleasesUri}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="World" />
                                    <TextBlock Text="View project releases" />
                                </StackPanel>
                            </HyperlinkButton>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <InfoBar
                Grid.Row="2"
                AutomationProperties.AutomationId="StatusInfoBar"
                AutomationProperties.LiveSetting="Polite"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}"
                Title="{x:Bind ViewModel.StatusTitle, Mode=OneWay}" />
        </Grid>
    </NavigationView>
</Page>
